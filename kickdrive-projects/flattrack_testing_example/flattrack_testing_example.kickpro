      <CANopenSubObject accessType="rw" kickStatusTxt="16:03:35 read ok" index="3301" name="Controller Mode" subIndex="01" nodeId="50" kickComment="1 - standard, 2 - hedgehog, 3 - float, 4 - clamp" actualValue="1" defaultValue="0" dataType="0006" kickStatus="1" objectType="7" kickUiFormat="type:combo; options:0,classic|1,standard|2,hedgehog|3,float / force free|4,clamp / stiff static pos"/>
      <CANopenSubObject accessType="rw" kickStatusTxt="16:03:35 read ok" index="3301" name="Additional User/Payload weight [g]" subIndex="04" nodeId="50" kickComment="payload / additional mass [g]. Position control is switched to 'off' when changing payload." actualValue="0" defaultValue="0" dataType="0006" kickStatus="1" objectType="7" PDOmapping="no" kickUiFormat="type:integer; range:0,65000"/>
      <CANopenSubObject accessType="rw" kickStatusTxt="16:03:35 read ok" index="3301" name="k0 Pos Gain" subIndex="06" nodeId="50" kickComment="Higher = faster in target / less stable. Normalized gain [scaling 0.1%, 1000 = 1]" actualValue="3000" defaultValue="1000" dataType="0003" kickStatus="1" objectType="7" kickUiFormat="type:integer; range:-2000,10000"/>
      <CANopenSubObject accessType="rw" kickStatusTxt="16:03:35 read ok" index="3301" name="k1 Vel Gain" subIndex="07" nodeId="50" kickComment="Higher = correct overshoot / fix end position low oscillation. Lower = more dynamic approach / fix resonance in end position. Normalized gain [scaling 0.1%, 1000 = 1]" actualValue="400" defaultValue="1000" dataType="0003" kickStatus="1" objectType="7" kickUiFormat="type:integer; range:1,1000"/>
      <CANopenSubObject accessType="rw" kickStatusTxt="16:03:35 read ok" index="3301" name="k2 Err Gain" subIndex="08" nodeId="50" kickComment="Higher = higher end pos. stiffness and accuracy / less stable. Normalized gain [scaling 0.1%, 1000 = 1]" actualValue="60" defaultValue="1000" dataType="0003" kickStatus="1" objectType="7" kickUiFormat="type:integer; range:1,200"/>
