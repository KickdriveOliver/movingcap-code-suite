      <CANopenSubObject accessType="rw" kickStatusTxt="16:03:35 read ok" index="3301" name="ks0 Pos Gain (Clamp Mode)" subIndex="10" nodeId="50" kickComment="Higher = higher end pos. stiffness. Normalized gain [scaling 0.1%, 1000 = 1]" actualValue="7000" defaultValue="1000" dataType="0003" kickStatus="1" objectType="7" kickUiFormat="type:integer; range:100,30000"/>
